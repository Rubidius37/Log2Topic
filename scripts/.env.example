# Optional integrations only.
# run_local.bat and the classification review dashboard do not require a .env file.
# Copy this file to scripts/.env only when enabling Notion or Cloudinary.

# Optional Notion API settings
NOTION_TOKEN=your_notion_integration_token_here
NOTION_DATABASE_ID=your_shared_database_id_here

# Optional Cloudinary settings for images uploaded through the Notion integration
# If configured, images are uploaded here to persist without a temporary local URL.
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset_here

# Optional: needed for delayed pending-image cleanup after a full sync and for
# scripts/cloudinary_cleanup.py --delete. Keep these private.
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# Optional post-sync Cloudinary cleanup mode: off, report, or auto.
# Full Notion sync defaults to auto. Daily-only sync always defaults to off.
# Auto mode deletes only pending uploads that were never committed to a
# successful Notion page. Committed images remain report/manual-delete only.
CLOUDINARY_CLEANUP_AFTER_SYNC=auto
CLOUDINARY_PENDING_GRACE_DAYS=14
CLOUDINARY_PENDING_MIN_FULL_SYNCS=3
CLOUDINARY_PENDING_MAX_DELETE=10
CLOUDINARY_PENDING_MAX_DELETE_RATIO=0.05
